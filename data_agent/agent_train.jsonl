{"id": "agent_code_generation_valid_006", "split": "train", "category": "code_generation_valid", "instruction_tr": "Arduino Mega'da iki butonla iki LED'i kontrol et.", "paraphrases": ["Mega'da 2 buton 2 LED uygulaması yaz."], "board": "arduino_mega2560", "framework": "arduino", "structured_requirements": {"modules": ["two_buttons_two_leds"], "pins": [], "params": [{"module": "two_buttons_two_leds", "params": {"debounce_ms": 50}}], "libraries": [], "unknown_modules": [], "missing": [], "ambiguous": []}, "expected_status": "ok", "expected_code": "#include <Arduino.h>\n\nconst int BTN1 = 2;\nconst int BTN2 = 3;\nconst int LED1 = 13;\nconst int LED2 = 12;\nconst unsigned long DEBOUNCE_MS = 50;\nconst int BTN_PINS[2] = {BTN1, BTN2};\nconst int LED_PINS[2] = {LED1, LED2};\nint _lastReading[2] = {HIGH, HIGH};\nint _stable[2] = {HIGH, HIGH};\nunsigned long _lastChange[2] = {0, 0};\n\nvoid setup() {\n  for (int i = 0; i < 2; i++) {\n    pinMode(BTN_PINS[i], INPUT_PULLUP);\n    pinMode(LED_PINS[i], OUTPUT);\n  }\n}\n\nvoid loop() {\n  for (int i = 0; i < 2; i++) {\n    int reading = digitalRead(BTN_PINS[i]);\n    if (reading != _lastReading[i]) { _lastChange[i] = millis(); }\n    if (millis() - _lastChange[i] > DEBOUNCE_MS) {\n      if (reading != _stable[i]) {\n        _stable[i] = reading;\n        digitalWrite(LED_PINS[i], _stable[i] == LOW ? HIGH : LOW);\n      }\n    }\n    _lastReading[i] = reading;\n  }\n}\n", "expected_libraries": [], "valid_pins": ["2", "3", "13", "12"], "invalid_pins": ["-1", "70"], "guard_expectations": [], "compile_expected": "host_syntax_ok", "notes": "Mega'da 54 dijital pin."}
